# --- Database -----------------------------------------------------------------
# Credentials for the local Postgres container (docker compose reads this file).
POSTGRES_USER=taskforge
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=taskforge

# Connection string used by the app. Must match the values above.
DATABASE_URL=postgres://taskforge:replace-with-a-strong-password@localhost:5433/taskforge
# Database used by `npm test`. It is wiped between test runs — never point this at real data.
TEST_DATABASE_URL=postgres://taskforge:replace-with-a-strong-password@localhost:5433/taskforge_test

# --- App ----------------------------------------------------------------------
# Public origin of the app. Used for CSRF origin checks and password-reset links.
APP_URL=http://localhost:3000
